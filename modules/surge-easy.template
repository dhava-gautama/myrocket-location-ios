#!name=MyRocket Location Spoofer (Easy Presets)
#!desc=Switch between two saved spots with one setting: OPTIONS 1, 2, or 3. Each fix can drift a few metres so repeated locations are not identical. Works with Surge.
#!homepage=https://github.com/{{REPO}}
#!date=2026-11-24
#!arguments=OPTIONS:1,latA:-6.111412,lngA:106.131867,latB:-5.9270616,lngB:105.9965498,customLat:51.5074,customLng:-0.1278,horizontalAccuracy:39,noise:true,debug:false
#!arguments-desc=OPTIONS: 1 = saved spot A, 2 = saved spot B, 3 = custom.\nReplace the lat/lng pairs with your own places; they are only examples.\nnoise drifts every fix by 3-7 m so the coordinate is not byte-identical each time.

[Script]
MyRocket Location (Easy) = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/{{REPO}}/{{BRANCH}}/dist/wloc.engine.js,argument=mode=response&OPTIONS={{{OPTIONS}}}&latA={{{latA}}}&lngA={{{lngA}}}&latB={{{latB}}}&lngB={{{lngB}}}&customLat={{{customLat}}}&customLng={{{customLng}}}&horizontalAccuracy={{{horizontalAccuracy}}}&noise={{{noise}}}&failOpen=true&debug={{{debug}}}

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

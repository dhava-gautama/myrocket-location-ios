#!name=MyRocket Location Spoofer
#!desc=Rewrites the coordinates inside Apple location responses so iOS reports your chosen spot. Works with Loon.
#!homepage=https://github.com/{{REPO}}
#!date=2026-08-31

[Argument]
enabled = switch,true,tag=Enable rewriting,desc=Off means the original response passes through untouched
latitude = input,"{{LATITUDE}}",tag=Latitude,desc=Target latitude
longitude = input,"{{LONGITUDE}}",tag=Longitude,desc=Target longitude
horizontalAccuracy = input,"{{HACC}}",tag=Horizontal accuracy (m),desc=Lower looks more GPS-like
configUrl = input,"",tag=Remote config URL,desc=Full loc.json URL; overrides manual lat/lng when set
debug = switch,true,tag=Debug logs,desc=Search 'MyRocket' in the Loon log viewer

[Script]
http-request ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/{{REPO}}/{{BRANCH}}/dist/wloc.engine.js, requires-body=false, timeout=3, tag=MyRocket Prepare, argument=[{debug}]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/{{REPO}}/{{BRANCH}}/dist/wloc.engine.js, requires-body=true, binary-body-mode=true, timeout=30, tag=MyRocket Location, argument=[{enabled},{latitude},{longitude},{horizontalAccuracy},{configUrl},{debug}]

[mitm]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
